<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Partnership Request</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
            color: #334155;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .header {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            padding: 32px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }
        .content {
            padding: 32px;
        }
        .user-profile {
            display: flex;
            align-items: center;
            margin-bottom: 24px;
            padding: 16px;
            background-color: #fff7ed;
            border-radius: 12px;
            border: 1px solid #ffedd5;
        }
        .avatar-placeholder {
            width: 48px;
            height: 48px;
            background-color: #ea580c;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 20px;
            margin-right: 16px;
        }
        .user-info h3 {
            margin: 0;
            color: #0f172a;
            font-size: 16px;
        }
        .user-info p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 14px;
        }
        .item-card {
            background-color: #f1f5f9;
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #ea580c;
        }
        .item-title {
            font-weight: bold;
            color: #0f172a;
            display: block;
            margin-bottom: 4px;
        }
        .item-type {
            font-size: 12px;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: 1px;
            font-weight: 700;
        }
        .btn {
            display: block;
            width: 100%;
            background-color: #0f172a;
            color: #ffffff;
            text-align: center;
            padding: 16px 0;
            border-radius: 12px;
            text-decoration: none;
            font-weight: bold;
            margin-top: 32px;
            transition: background-color 0.2s;
        }
        .btn:hover {
            background-color: #1e293b;
        }
        .footer {
            background-color: #f8fafc;
            padding: 24px;
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>New Partnership Proposal</h1>
        </div>
        <div class="content">
            <p style="font-size: 16px; line-height: 1.6;">Hello <strong>{{receiverName}}</strong>,</p>
            <p style="font-size: 16px; line-height: 1.6; color: #475569;">
                {{senderName}} wants to collaborate with you! Expanding your network helps you reach more customers and grow your business.
            </p>

            <div class="user-profile">
                <div class="avatar-placeholder">
                    {{senderInitials}}
                </div>
                <div class="user-info">
                    <h3>{{senderName}}</h3>
                    <p>{{senderEmail}}</p>
                </div>
            </div>

            {{#if isItemRequest}}
            <p style="font-size: 14px; font-weight: 600; margin-top: 24px; color: #334155;">PROPOSED INTEGRATION:</p>
            <div class="item-card">
                <span class="item-type">Base Item (Theirs)</span>
                <span class="item-title">{{baseItemName}}</span>
                <div style="margin: 8px 0; border-top: 1px dashed #cbd5e1;"></div>
                <span class="item-type" style="color: #ea580c;">Plus Item (Yours)</span>
                <span class="item-title">{{plusItemName}}</span>
            </div>
            {{/if}}

            <a href="{{actionUrl}}" class="btn">View & Respond in Dashboard</a>
        </div>
        <div class="footer">
            <p>&copy; {{year}} McomMall. All rights reserved.</p>
            <p>You received this email because you are a registered business owner on McomMall.</p>
        </div>
    </div>
</body>
</html>
